{
	admin off
	auto_https off
}

(routes) {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle {
		reverse_proxy app:3000
	}
}

# Entrée publique (via le nginx du serveur) : l'administration des comptes n'est jamais exposée,
# même avec une clé valide. « route » garde l'ordre écrit.
:8000 {
	encode zstd gzip
	header -Server
	route {
		respond /auth/v1/admin* 404
		import routes
	}
}

# Entrée interne (réseau Docker uniquement, port non publié) pour les appels du serveur Next.js.
:8001 {
	import routes
}
